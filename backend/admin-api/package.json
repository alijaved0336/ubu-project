{
  "name": "ubu-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "NODE_ENV=dev nest start --watch",
    "start:production": "NODE_ENV=production nest start",
    "start:staging": "NODE_ENV=staging nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:dev-docker": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "nest build && npx typeorm -d dist/infrastructure/orm/migration/data-source.js",
    "migration-create": "nest build && npx typeorm migration:create",
    "migration-generate": "npm run typeorm -- migration:generate",
    "migration-start": "npm run typeorm -- migration:run",
    "migration-revert": "npm run typeorm -- migration:revert",
    "populate-affliate_ids": "npx nestjs-command populate-affliate_ids",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org ubu --project node-nestjs ./dist && sentry-cli sourcemaps upload --org ubu --project node-nestjs ./dist",
    "migrate-show": "npm run typeorm -- migration:show",
    "populate-questionnaire": "npx nestjs-command populate-questionnaire",
    "prepare": "echo 'Husky installed but not active'"
  },
  "dependencies": {
    "@arendajaelu/nestjs-passport-apple": "^2.0.3",
