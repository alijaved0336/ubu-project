    "ffmpeg-static": "^5.2.0",
    "firebase-admin": "^13.4.0",
    "fluent-ffmpeg": "^2.1.3",
    "install": "^0.13.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "mailgun-js": "^0.22.0",
    "mime-types": "^2.1.35",
    "multer": "^1.4.5-lts.1",
    "multer-s3": "^3.0.1",
    "nestjs-command": "^3.1.4",
    "nodemailer": "^6.9.15",
